# Claude job runner queue/logs (local only)
/.claude-runner/

# Scratch saves for tool runs (always disposable)
review/tmp/

# Per-run race/review output (29 September): reports, rosters, saves and drivers JSON are regenerated by
# the tools and run to many MB each. Keep the written reviews (*.md) and summaries (*.txt).
review/ui-screens/**/*.json
review/hillcrest-race/**/*.json
review/class-sort/*/*.json
review/map-sweep/**/*.json
review/unity-35/frame-cost-*/**/probe/
source-art/__pycache__/
# Racing AI v2 studies (docs/46): per-run JSON from frame-cost-200 on; the results live in docs/46.
review/unity-35/frame-cost-2[0-9][0-9]/
# Editor-check scratch output written by every build.
review/unity-01/
review/unity-04/bodies-*/
review/unity-04/profiles-*/
# Sound harness renders (tools/sound-harness.ps1): regenerated in seconds.
review/sound/
# Grain-bank rev-tracking check images (tools/engine-grains.py): regenerated.
review/grains/

# Music previews (tools/music/compose.py): regenerated.
review/music/

# Engine scorecards (docs/55): generated pages, clips and captures; regenerate with tools/engine-compare*.{py,sh} and
# tools/engine-ingame*.py. Duke race reviews (docs/54) and map-sweep runs likewise.
review/engine-compare/
review/engine-compare-baseline/
review/engine-ingame/
review/duke-race/
review/map-sweep/*/
# Car-builder renders and review .blend files (source-art/build_family_cars.py --render/--lineup): regenerated.
review/cars/
