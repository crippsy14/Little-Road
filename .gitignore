# Godot generated cache
game/.godot/

# Exported builds
builds/
exports/

# Editor and OS temporary files
*.tmp
*.blend1
*.blend2
Thumbs.db
.DS_Store
review/test-save.json*

# Local generated evidence (24 September handoff; original files are preserved)
review/**/*.track.json
review/**/*.driver-frames.json
review/**/*.traffic.json
review/**/*.motion-prediction.json
review/**/*.path-prediction.json
review/**/batch.json
review/**/*.log
review/**/*.bak
review/**/*.pid
review/**/*.lnk
review/**/*.png
review/**/*.jpg
review/**/*.jpeg
# Per-race study output from 113 on (race.json is ~2 MB pretty-printed).
# Results are kept in review/unity-35/frame-cost-<N>-review.md and -summary.txt.
review/unity-35/frame-cost-11[3-9]/*/*.json
review/unity-35/frame-cost-1[2-9][0-9]/*/*.json

